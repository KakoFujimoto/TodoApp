@using TodoApp.Models
@model TodoTask

<div class="task-card" data-id="@Model.Id">
    <h4>@Model.Title</h4>
    <p>優先度: @Model.Priority</p>

    @if (!string.IsNullOrEmpty(Model.Body))
    {
        <p class="multiline-text">@Model.Body</p>
    }

    @if (Model.DueDate.HasValue)
    {
        <p class="task-due-date">期日: @Model.DueDate.Value.ToString("yyyy-MM-dd")</p>
    }
    <p>カテゴリ: @Model.Category</p>

    <form method="post" action="/Index?handler=Complete" class="complete-form">
        <input type="hidden" name="id" value="@Model.Id" />
        @Html.AntiForgeryToken()
        <label>
            <input type="checkbox" name="isComplete" value="true" />
            完了
        </label>
    </form>

    <a href="@Url.Page("Edit", new { id = Model.Id })">編集</a>
</div>
