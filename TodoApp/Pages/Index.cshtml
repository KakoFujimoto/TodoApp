@page
@model TodoApp.Pages.IndexModel
@using TodoApp.Models

<h2>タスクリスト</h2>
<form method="post">
    <div>
        <label asp-for="FormData.Title">タイトル:</label>
        <input type="text" asp-for="FormData.Title" placeholder="新しいタスクのタイトル" required maxlength="" />
        <span asp-validation-for="FormData.Title"></span>
    </div>
    <div>
        <label asp-for="FormData.Body">本文:</label>
        <textarea asp-for="FormData.Body" placeholder="タスクの詳細内容" maxlength=""></textarea>
        <span asp-validation-for="FormData.Body"></span>
    </div>
    <div>
        <label asp-for="FormData.Priority">優先度:</label>
        <select asp-for="FormData.Priority"
            asp-items="@(new SelectList(Enum.GetValues(typeof(Priority)).Cast<Priority>().Where(p => p != Priority.None)))">
            <option value="">-- 優先度を選択してください --</option>
        </select>
        <span asp-validation-for="FormData.Priority"></span>
    </div>
    <button type="submit">追加</button>
</form>

<h3>タスク一覧</h3>
<form method="get">
    <label for="orderBy">並びの基準:</label>
    <select asp-for="SelectedOrderBy" id="orderBy" asp-items="Html.GetEnumSelectList<TaskOrderBy>()">
    </select>

    <label for="descending">並び順:</label>
    <select id="descending" name="SelectedDescending">
        <option value="true" selected="@(Model.SelectedDescending ?? true)">降順</option>
        <option value="false" selected="@(!(Model.SelectedDescending ?? true))">昇順</option>
    </select>

    <button type="submit">並び替え</button>
</form>

<p>
    <a asp-page="/Archive" class="archive-link">→ アーカイブされたタスクを見る</a>
</p>
<div id="task-list">

    @foreach (var task in Model.Tasks)
    {
        @await Component.InvokeAsync("TaskCard", new { task })
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const forms = document.querySelectorAll('.complete-form');

        forms.forEach(function (form) {
            const checkbox = form.querySelector('input[type="checkbox"]');


            checkbox.addEventListener('click', function (e) {
                const message = 'このタスクを完了にしますか？';
                if (!confirm(message)) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    this.checked = !this.checked;
                } else {
                    form.submit();
                }
            });
        });

        new Sortable(document.getElementById('task-list'), {
            animation: 150,
            ghostClass: 'sortable-ghost',
            onEnd: function (evt) {
                const order = [];
                document.querySelectorAll('#task-list .task-card').forEach(el => {
                    order.push(el.getAttribute('data-id'));
                });
                console.log('new order:', order);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                fetch('/?handler=UpdateOrder', {
                    method: 'POST',
                    headers: {
                        'Content-type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(order)
                }).then(response => {
                    if (!response.ok) {
                        throw new Error('順序保存に失敗しました');
                    }
                    console.log('順序が保存されました');
                }).catch(error => {
                    console.error('順序保存エラー', error);
                });
            }
        });
    });
</script>
