@page
@model TodoApp.Pages.IndexModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TodoApp</title>
</head>

<body>
    <h2>タスクリスト</h2>

    <!-- タスク追加フォーム -->
    <form method="post">
        <div>
            <label for="NewTask">タイトル:</label>
            <input type="text" asp-for="NewTask" placeholder="新しいタスクのタイトル" required />
        </div>
        <div>
            <label for="NewTaskBody">本文:</label>
            <textarea asp-for="NewTaskBody" placeholder="タスクの詳細内容"></textarea>
        </div>
        <button type="submit">追加</button>
    </form>

    <h3>タスク一覧</h3>
    <ul>
        @foreach (var task in Model.Tasks)
        {
            <li>
                <strong>@task.Title</strong><br />
                @if (!string.IsNullOrEmpty(task.Body))
                {
                    <p>@task.Body</p>  <!-- 本文の表示 -->
                }
            </li>
        }
    </ul>
</body>

</html>
