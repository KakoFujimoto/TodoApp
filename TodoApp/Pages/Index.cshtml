@page
@model TodoApp.Pages.IndexModel

<h2>タスクリスト</h2>
<form method="post">
    <div>
        <label asp-for="FormData.Title">タイトル:</label>
        <input type="text" asp-for="FormData.Title" placeholder="新しいタスクのタイトル" required maxlength="" />
        <span asp-validation-for="FormData.Title"></span>
    </div>
    <div>
        <label asp-for="FormData.Body">本文:</label>
        <textarea asp-for="FormData.Body" placeholder="タスクの詳細内容" maxlength=""></textarea>
        <span asp-validation-for="FormData.Body"></span>
    </div>
    <button type="submit">追加</button>
</form>

<h3>タスク一覧</h3>
<p>
    <a asp-page="/Archive" class="archive-link">→ アーカイブされたタスクを見る</a>
</p>
<ul>

    @foreach (var task in Model.Tasks)
        {
            <li class="task-item">
            <h4>@task.Title</h4>

            @if (!string.IsNullOrEmpty(task.Body))
                   { 
                <p class="multiline-text">@task.Body</p>
            }
    
                <form id = "complete-form" method="post" asp-page-handler="Complete">
                    <input type="hidden" name="id" value="@task.Id" />
                    <label>
                    <input type="checkbox" />
                    完了
                    </label>
                </form>

                <a href="@Url.Page("Edit", new { id = task.Id })" class="edit-button">
                    <i class="fas fa-pencil-alt"></i>
                </a>
            </li>
    }
</ul>

<script>
document.addEventListener('DOMContentLoaded', function(){
    const form = document.getElementById('complete-form');
    const checkbox = form.querySelector('input[type = "checkbox"]');

    checkbox.addEventListener('click', function(e){
        const message = 'このタスクを完了にしますか？';
        if(!confirm(message)){
            e.preventDefault();
            e.stopImmediatePropagation();
            this.checked = !this.checked;
        } else {
            form.submit();
        }
    });
});
</script>
