@page
@model TodoApp.Pages.IndexModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TodoApp</title>
</head>

<body>
    <h2>タスクリスト</h2>

    <!-- タスク追加フォーム -->
    <form method="post">
        <div>
            <label asp-for="NewTodoTask.Title">タイトル:</label>
            <input type="text" asp-for="NewTodoTask.Title" placeholder="新しいタスクのタイトル" required />
            <span asp-validation-for="NewTodoTask.Title"></span>
        </div>
        <div>
            <label asp-for="NewTodoTask.Body">本文:</label>
            <textarea asp-for="NewTodoTask.Body" placeholder="タスクの詳細内容"></textarea>
            <span asp-validation-for="NewTodoTask.Body"></span>
        </div>
        <button type="submit">追加</button>
    </form>

    <h3>タスク一覧</h3>
    <ul>
        @foreach (var task in Model.Tasks)
        {
            <li>
                <h4>@task.Title</h4><br />
                @if (!string.IsNullOrEmpty(task.Body))
                {
                    <p class="multiline-text">@task.Body</p>
                }
            </li>
        }
    </ul>
</body>

</html>
