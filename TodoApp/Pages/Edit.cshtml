@page "{id?}"
@model EditModel
@{
    ViewData["Title"] = "Edit Task";
}

<h2>Edit Task</h2>

<form method="post">
    <input type="hidden" asp-for="FormData.Id" />

    <div class="form-group">
        <label asp-for="FormData.Title"></label>
        <input asp-for="FormData.Title" class="form-control" />
        <span asp-validation-for="FormData.Title"></span>
    </div>

    <div class="form-group">
        <label asp-for="FormData.Body"></label>
        <textarea asp-for="FormData.Body" class="form-control"></textarea>
        <span asp-validation-for="FormData.Body"></span>
    </div>

    <div class="button-group">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

<form method="post" asp-page-handler="Delete" onsubmit="return confirm('本当に削除しますか？');" class="inline-delete-form">
    <input asp-for="FormData.Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Delete</button>
</form>
